    "version": "0.2.0",
    "configurations": [
        {
            "name": "Add",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/expenseTracker/bin/Debug/net8.0/expenseTracker.dll",
            "args": ["add", "--description", "netflix", "--amount", "10"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "List",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/expenseTracker/bin/Debug/net8.0/expenseTracker.dll",
            "args": ["list"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
    ]
}